#include <SPI.h>
#include <MFRC522.h>
#include <BLEDevice.h>
#include <BLEServer.h>
#include <BLEUtils.h>
#include <BLE2902.h> 

// --- PINS DEL MAQUINARI ---
#define SS_PIN 5
#define RST_PIN 21
#define LED_PIN 22

MFRC522 rfid(SS_PIN, RST_PIN);

// --- CONFIGURACIÓ BLUETOOTH ---
#define SERVICE_UUID        "4fafc201-1fb5-459e-8fcc-c5c9c331914b"
#define CHARACTERISTIC_UUID "beb5483e-36e1-4688-b7f5-ea07361b26a8"

BLEServer* pServer = NULL;
BLECharacteristic* pCharacteristic = NULL;
bool deviceConnected = false;

String nomLector = "ESP32_Menjador"; 

class MyServerCallbacks: public BLEServerCallbacks {
    void onConnect(BLEServer* pServer) {
      deviceConnected = true;
      Serial.println("nRF Connect connectat al Bluetooth!");
    };
    void onDisconnect(BLEServer* pServer) {
      deviceConnected = false;
      Serial.println("App desconnectada. Tornant a emetre...");
      BLEDevice::startAdvertising(); 
    }
};

void setup() {
  Serial.begin(115200);
  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, LOW); 

  SPI.begin();
  rfid.PCD_Init();

  Serial.println("Iniciant Bluetooth...");
  BLEDevice::init(nomLector.c_str()); 
  
  pServer = BLEDevice::createServer();
  pServer->setCallbacks(new MyServerCallbacks());
  BLEService *pService = pServer->createService(SERVICE_UUID);
  
  // Creem la característica amb permisos de LECTURA i NOTIFICACIÓ
  pCharacteristic = pService->createCharacteristic(
                      CHARACTERISTIC_UUID,
                      BLECharacteristic::PROPERTY_READ   |
                      BLECharacteristic::PROPERTY_NOTIFY
                    );
                    
  // Aquest descriptor és OBLIGATORI perquè a nRF Connect t'aparegui el botó de les fletxetes (Notify)
  pCharacteristic->addDescriptor(new BLE2902());
  
  // Posem un valor inicial perquè el puguis llegir només connectar-te
  pCharacteristic->setValue("Esperant pacient...");
  
  pService->start();
  
  BLEAdvertising *pAdvertising = BLEDevice::getAdvertising();
  pAdvertising->addServiceUUID(SERVICE_UUID);
  pAdvertising->setScanResponse(false);
  pAdvertising->setMinPreferred(0x0);  
  BLEDevice::startAdvertising();
  
  Serial.println("Bluetooth a punt! Obre nRF Connect al mòbil.");
}

void loop() {
  if (!rfid.PICC_IsNewCardPresent()) return;
  if (!rfid.PICC_ReadCardSerial()) return;

  String tagUID = "";
  for (byte i = 0; i < rfid.uid.size; i++) {
    tagUID += String(rfid.uid.uidByte[i] < 0x10 ? "0" : "");
    tagUID += String(rfid.uid.uidByte[i], HEX);
  }
  tagUID.toUpperCase(); 
  
  Serial.println("TAG: " + tagUID);
  digitalWrite(LED_PIN, HIGH);

  if (deviceConnected) {
    // Creem el JSON net per enviar
    String missatge = "{\"uid\":\"" + tagUID + "\", \"lector\":\"" + nomLector + "\"}";
    
    // Actualitzem el valor i enviem la notificació al mòbil
    pCharacteristic->setValue(missatge.c_str());
    pCharacteristic->notify();
    
    Serial.println("Enviat a nRF Connect: " + missatge);
  }

  delay(1000); 
  digitalWrite(LED_PIN, LOW);
  rfid.PICC_HaltA();
  delay(1500); 
}

